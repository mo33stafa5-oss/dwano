# Copy to .env.local (local) or add in Vercel → Settings → Environment Variables, then Redeploy.

# 1) PostgreSQL (Vercel → Storage → Create → Neon/Supabase Postgres → Connect to project; adds POSTGRES_URL automatically)
DATABASE_URL=            # or POSTGRES_URL

# 2) Sessions + first admin (the admin is created/updated from these on first login at /login)
SESSION_SECRET=          # long random string (>= 32 chars)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=          # long unique password

# 3) Images (Vercel → Storage → Blob, access PRIVATE, connect to project)
BLOB_STORE_ID=            # added automatically when a (private) Blob store is connected; auth is OIDC
# BLOB_READ_WRITE_TOKEN=  # optional fallback only (local dev)
PRESCRIPTION_KEY=        # >= 24 random chars. Prescriptions are AES-256-GCM encrypted before upload. Losing it makes old images unreadable.

# 4) Optional email notification of new requests (no email field is collected from customers)
RESEND_API_KEY=
# REQUEST_NOTIFY_EMAIL=jesse121973@gmail.com
# REQUEST_FROM_EMAIL=Dwano <onboarding@resend.dev>
