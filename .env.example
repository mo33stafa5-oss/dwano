# Copy to .env.local (local) or add in Vercel → Settings → Environment Variables, then Redeploy.

# 1) Email for every request
RESEND_API_KEY=
# REQUEST_NOTIFY_EMAIL=jesse121973@gmail.com
# REQUEST_FROM_EMAIL=Dwano <onboarding@resend.dev>

# 2) Admin login for /admin/requests (choose a long, unique password)
ADMIN_PASSWORD=
# ADMIN_SESSION_SECRET=   # optional, any long random string

# 3) Storage so requests show in the admin from any device.
#    Vercel → Storage → Create → Upstash Redis → Connect to this project (adds these automatically):
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
